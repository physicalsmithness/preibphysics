# Reference material (past papers, mark schemes, copyrighted PDFs).
# Kept locally so the architecture chat in Cowork can read them when needed,
# but never pushed to the public repo. Pattern matches any folder named
# `reference/` anywhere in the tree, so you can put a per-topic one under
# `new/reference/` or a single shared one at the root, your choice.
reference/

# Internal architecture and authoring docs. They live alongside the code so
# Cowork and author chats can read them, but they shouldn't be in the
# deployed repo. Author briefs, schema specs, decision logs, proposed
# vocabularies, content gotchas, commissions for other chats, and
# implementation plans are all internal-only.
AUTHOR_BRIEF_*.md
SCHEMA_*.md
*_decisions.md
*_proposal.md
TOPIC*_GOTCHAS.md
COMMISSION_*.md
BRIEF_*.md
PLAN_*.md
*feedback_for_*.md
topic*_atom_*.md
topic*_coverage_*.md
topic*_multicell_*.json
HANDOVER_*.md
MANIFEST*.md
FINAL_PACK_*.md
*_v2_FINAL.js
FINAL_merged_*.json
atomisation_plan.md
atomisations.js
chunk5.js
chunks_3_4_sources.txt
round2_patches.js
gap_fill_questions.js

# Question bank editor — for teacher use only. Lives in the live folder so
# Smith can use it locally, but never pushed to the deployed public repo so
# students can't reach it by URL even if they guess the path.
editor.html
editor.css
editor.js

